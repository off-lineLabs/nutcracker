    <!-- Tutorial Strings -->
    <string name="tutorial_welcome_title">Welcome to Nutcracker!</string>
    <string name="tutorial_welcome_description">Let\'s take a quick tour of your calorie tracking app. I\'ll show you the key features to get you started.</string>
    
    <string name="tutorial_calorie_ring_title">Daily Calorie Tracking</string>
    <string name="tutorial_calorie_ring_description">This ring shows your daily calorie progress. You can see how many calories you still have available, how many you’ve consumed, and your daily goal.</string>
    
    <string name="tutorial_add_meal_title">Food Tab</string>
    <string name="tutorial_add_meal_description">Tap Food or swipe to log meals. Search, scan a barcode to automatically get a product’s nutritional data, browse the food database or use your recipes.</string>
    
    <string name="tutorial_add_exercise_title">Exercise Tab</string>
    <string name="tutorial_add_exercise_description">Tap Exercise or swipe to log workouts. Use the gym menu at the top to keep separate exercises and weights per gym.</string>
    
    <string name="tutorial_calendar_title">Change Date</string>
    <string name="tutorial_calendar_description">View or edit entries from different days. Perfect for logging meals you forgot to track.</string>
    
    <string name="tutorial_analytics_title">View Progress</string>
    <string name="tutorial_analytics_description">See detailed analytics and charts of your nutrition and exercise progress over time.</string>
    
    <string name="tutorial_settings_title">App Settings</string>
    <string name="tutorial_settings_description">Customize your experience, set goals, change themes, and manage your data.</string>
    
    <string name="tutorial_edit_goals_title">Edit Daily Goals</string>
    <string name="tutorial_edit_goals_description">You can (and should) edit your daily goals according to your needs. Tap this icon to customize your calorie and nutrient targets.</string>
    
    <string name="tutorial_supplement_pill_title">Track Supplements</string>
    <string name="tutorial_supplement_pill_description">Keep track of your daily supplement intake. You can click to toggle as taken or long press to rename. Up to 5 supplements can be added.</string>
    
    <string name="tutorial_check_in_history_title">Recent Check-In History</string>
    <string name="tutorial_check_in_history_description">Here you can see the meals and exercises you checked in for the day. Scroll to view all entries and tap any item to edit it.</string>
    
    <string name="tutorial_completion_title">You\'re All Set!</string>
    <string name="tutorial_completion_description">That\'s it! You now know how to use Nutcracker. Start tracking your meals and exercises to reach your health goals.</string>
    
